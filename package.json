{
  "name": "headroom",
  "productName": "Headroom",
  "version": "1.0.0",
  "private": true,
  "description": "See what fills your Mac and clean caches, simulators and old build files safely.",
  "author": "Marvin Splitt",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dry": "electron . --dry-run",
    "test": "node test/run.mjs",
    "icon": "electron build/render-icon.mjs",
    "build": "electron-builder --mac --dir",
    "install-app": "npm run build && node scripts/install-app.mjs"
  },
  "build": {
    "appId": "com.marvinsplitt.headroom",
    "productName": "Headroom",
    "copyright": "Copyright © 2026 Marvin Splitt",
    "files": [
      "electron/**",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dir"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Headroom asks Finder to empty the Trash when you clean it.",
        "NSDesktopFolderUsageDescription": "Headroom measures the folders you open in Explore.",
        "NSDocumentsFolderUsageDescription": "Headroom measures the folders you open in Explore.",
        "NSDownloadsFolderUsageDescription": "Headroom looks for old installers in your Downloads folder."
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  }
}
